##Example of how to perform statistics to support observed changes in Alpha diversity
##Kruskal-Wallis test for correlation between observed species and depth
##alpha_meta_test= combined metadata and alpha summary file
kruskal.test(Observed ~ depth, data = alpha_meta_test)
alpha_plot = plot_richness(Tas_rare_phyloseq, x = "type", measures=c("Observed", "Shannon"), color = "location")
#Add a boxplot using the geom function of ggplot
alpha_plot + geom_boxplot()
##Example of how to perform statistics to support observed changes in Alpha diversity
##Kruskal-Wallis test for correlation between observed species and depth
##alpha_meta_test= combined metadata and alpha summary file
kruskal.test(Observed ~ type, data = alpha_meta_test)
kruskal.test(Shannon ~ type, data = alpha_meta_test)
library(lme4)
library(grid)
# Richness
fit_rich_depth <- lmList(Observed ~ type | location, data = alpha_meta_test)
summary(fit_rich_depth)
summary(fit_rich_depth)$r.squared
#red to blue color scale (10 factors)
cc <- scales::seq_gradient_pal("blue", "red", "Lab")(seq(0,1,length.out=10))
rich_depth_treatment_plot <- ggplot(alpha_meta_test, aes(x=as.numeric(depth), y=Observed)) + geom_point(size=4, aes(colour=depth)) + geom_smooth(method = lm) + facet_grid(. ~ type, drop = TRUE, space = "fixed", scales = "free") +
xlab("depth") + labs(y = expression ("Richness")) +
expand_limits(y=0) + scale_y_continuous() + scale_colour_manual(values=cc)
rich_depth_treatment_plot
