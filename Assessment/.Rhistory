otus<-read.csv("~/Dropbox/Otago/Teaching/Micro336/Lab info/Assessment/Dataset-Meadows/otus.csv", header=TRUE, row.names=1, check.names=FALSE)
otus<-t(otus)
taxa<-read.csv("~/Dropbox/Otago/Teaching/Micro336/Lab info/Assessment/Dataset-Meadows/tax.csv", row.names=1, check.names=FALSE, header=TRUE)
meta<-read.table("~/Dropbox/Otago/Teaching/Micro336/Lab info/Assessment/Dataset-Meadows/sample_data.txt", sep="\t", header=TRUE)
OTU = otu_table(otus, taxa_are_rows=TRUE)
rownames(OTU)<-paste("sp", rownames(OTU))
rownames(OTU)<-gsub(" ", "", rownames(OTU) )
TAX = tax_table(taxa)
META = sample_data(meta)
Tas_phyloseq <- merge_phyloseq(OTU, TAX, META)
#uzdir <- "~/Dropbox/Otago/Teaching/Micro336/Lab info/Assessment/Dataset-Meadows/"
#otutable_biom_file <- paste("/Volumes/Pteradactyl/MICR336_lab_data/Taş_permafrost_fire/study_1530_110217-195812/BIOM/30686/", "Tas_json.biom", sep = "")
#map_file <- paste("/Volumes/Pteradactyl/MICR336_lab_data/Taş_permafrost_fire/", "Tas_metadata.txt", sep = "")
Tas_phyloseq
#prune and rarify to 1000
Tas_rare_phyloseq = prune_taxa(taxa_sums(Tas_phyloseq) > 1, Tas_phyloseq)
Tas_rare_phyloseq = rarefy_even_depth(Tas_rare_phyloseq, 1000)
any(sample_sums(Tas_rare_phyloseq) < 1)
Tas_rare_phyloseq
#plot
readsumsdf = data.frame(nreads = sort(taxa_sums(Tas_rare_phyloseq), TRUE), sorted = 1:ntaxa(Tas_rare_phyloseq),
type = "OTU")
#repeat above for sequences per sample
readsumsdf = rbind(readsumsdf, data.frame(nreads = sort(sample_sums(Tas_rare_phyloseq),
TRUE), sorted = 1:nsamples(Tas_rare_phyloseq), type = "Samples"))
title = "Total number of reads"
#plot results
p = ggplot(readsumsdf, aes(x = sorted, y = nreads)) + geom_bar(stat = "identity")
p + ggtitle(title) + scale_y_log10() + facet_wrap(~type, 1, scales = "free")
alpha_summary_test<- estimate_richness(Tas_rare_phyloseq, measures = c("Observed", "Shannon"))
summary(alpha_summary_test)
# Combine results with sample_data.
alpha_meta_test <- data.frame(alpha_summary_test, sample_data(Tas_rare_phyloseq))
alpha_plot = plot_richness(Tas_rare_phyloseq, x = "depth", measures=c("Observed", "Shannon"), color = "Treatment")
#Add a boxplot using the geom function of ggplot
alpha_plot + geom_boxplot()
alpha_plot = plot_richness(Tas_rare_phyloseq, x = "depth", measures=c("Observed", "Shannon"), color = "type")
#Add a boxplot using the geom function of ggplot
alpha_plot + geom_boxplot()
