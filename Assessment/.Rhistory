Tas_ano$signif
Tas_ano$statistic
#ADONIS TEST
#Create a data frame using your sample_data
df = as(sample_data(Tas_rare_phyloseq), "data.frame")
#Calculate your Bray distance matrix
d = distance(Tas_rare_phyloseq, "bray")
#Perform your ADONIS test
Depth_adonis = adonis(d ~ type, df)
#Check results
Depth_adonis
#Perform your ADONIS test with interaction by treatment
Depth_Treatment_adonis = adonis(d ~ type*location, df)
#Check results
Depth_Treatment_adonis
