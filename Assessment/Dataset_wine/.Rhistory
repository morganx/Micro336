HMPv35 <- "/Users/sergiomorales/Dropbox/Micro336/Lab info/Week3/HMPv35.RData"
load(HMPv35)
HMPv35
HMPv35Throat = subset_samples(HMPv35, HMPbodysubsite == "Throat")
HMPv35Throat
HMPv35Throat = prune_taxa(taxa_sums(HMPv35Throat) > 1, HMPv35Throat)
HMPv35Throat = rarefy_even_depth(HMPv35Throat, 1000)
any(sample_sums(HMPv35Throat) < 1)
#plot
readsumsdf = data.frame(nreads = sort(taxa_sums(HMPv35Throat), TRUE), sorted = 1:ntaxa(HMPv35Throat),
type = "OTU")
#repeat above for sequences per sample
readsumsdf = rbind(readsumsdf, data.frame(nreads = sort(sample_sums(HMPv35Throat),
TRUE), sorted = 1:nsamples(HMPv35Throat), type = "Samples"))
title = "Total number of reads"
#plot results
p = ggplot(readsumsdf, aes(x = sorted, y = nreads)) + geom_bar(stat = "identity")
p + ggtitle(title) + scale_y_log10() + facet_wrap(~type, 1, scales = "free")
library("ggplot2", lib.loc="/Library/Frameworks/R.framework/Versions/3.4/Resources/library")
any(sample_sums(HMPv35Throat) < 1)
#plot
readsumsdf = data.frame(nreads = sort(taxa_sums(HMPv35Throat), TRUE), sorted = 1:ntaxa(HMPv35Throat),
type = "OTU")
#repeat above for sequences per sample
readsumsdf = rbind(readsumsdf, data.frame(nreads = sort(sample_sums(HMPv35Throat),
TRUE), sorted = 1:nsamples(HMPv35Throat), type = "Samples"))
title = "Total number of reads"
#plot results
p = ggplot(readsumsdf, aes(x = sorted, y = nreads)) + geom_bar(stat = "identity")
p + ggtitle(title) + scale_y_log10() + facet_wrap(~type, 1, scales = "free")
alpha_summary_H35_T<- estimate_richness(HMPv35Throat, measures = c("Observed", "Shannon"))
summary(alpha_summary_H35_T)
# Combine results with sample_data. This is useful if we wish to plot later against other variable or information.
alpha_meta_H35_T <- data.frame(alpha_summary_H35_T, sample_data(HMPv35Throat))
levels(sample_data(HMPv35Throat)$RUNCENTER)
p = plot_richness(HMPv35Throat, x = "RUNCENTER", measures=c("Observed", "Shannon"))
#Add a boxplot using the geom function of ggplot
p + geom_boxplot()
##Example of how to perform statistics to support observed changes in Alpha diversity
##Kruskal-Wallis test for correlation between observed species and RUNCENTER
##alpha_meta_H35_T= combined metadata and alpha summary file
kruskal.test(Observed ~ RUNCENTER, data = alpha_meta_H35_T)
kruskal.test(Shannon ~ RUNCENTER, data = alpha_meta_H35_T)
HMPv35
#How many taxa are found
ntaxa(HMPv35)
#Prune taxa with less than 1 count and rename file
H35_thr_trim = prune_taxa(taxa_sums(HMPv35throat) > 1, HMPv35throat)
#Recheck values
any(sample_sums(H35_thr_trim) == 0)
any(sample_sums(H35_thr_trim) > 0)
sum(taxa_sums(H35_thr_trim) > 0)
any(sample_sums(H35_thr_trim) < 1)
sum(taxa_sums(H35_thr_trim) < 1)
#Rarefy to even sequencing depth (1000 sequences)
H35_thr_rare = rarefy_even_depth(H35_thr_trim, 1000)
#load library
library(ggplot2)
#determine the sum total taxa per sample, sort and make into a new data frame
readsumsdf = data.frame(nreads = sort(taxa_sums(H35_thr_rare), TRUE), sorted = 1:ntaxa(H35_thr_rare), type = "OTU")
#repeat above for sequences per sample
readsumsdf = rbind(readsumsdf, data.frame(nreads = sort(sample_sums(H35_thr_rare), TRUE), sorted = 1:nsamples(H35_thr_rare), type = "Samples"))
title = "Total number of reads"
#plot results
p_1 = ggplot(readsumsdf, aes(x = sorted, y = nreads)) + geom_bar(stat = "identity")
p_1 + ggtitle(title) + scale_y_log10() + facet_wrap(~type, 1, scales = "free")
#Let's imagine you only wish to explore a subset of your data, for example a single bodysite. You can subset your data using a variable with 'subset_samples'
HMPv35throat = subset_samples(HMPv35, HMPbodysubsite == "Throat")
HMPv35throat
#Prune taxa with less than 1 count and rename file
H35_thr_trim = prune_taxa(taxa_sums(HMPv35throat) > 1, HMPv35throat)
#Recheck values
any(sample_sums(H35_thr_trim) == 0)
any(sample_sums(H35_thr_trim) > 0)
sum(taxa_sums(H35_thr_trim) > 0)
any(sample_sums(H35_thr_trim) < 1)
#Prune taxa with less than 1 count and rename file
H35_thr_trim = prune_taxa(taxa_sums(HMPv35throat) > 1, HMPv35throat)
#Recheck values
any(sample_sums(H35_thr_trim) == 0)
any(sample_sums(H35_thr_trim) > 0)
sum(taxa_sums(H35_thr_trim) > 0)
any(sample_sums(H35_thr_trim) < 1)
sum(taxa_sums(H35_thr_trim) < 1)
#Rarefy to even sequencing depth (1000 sequences)
H35_thr_rare = rarefy_even_depth(H35_thr_trim, 1000)
#load library
library(ggplot2)
#determine the sum total taxa per sample, sort and make into a new data frame
readsumsdf = data.frame(nreads = sort(taxa_sums(H35_thr_rare), TRUE), sorted = 1:ntaxa(H35_thr_rare), type = "OTU")
#repeat above for sequences per sample
readsumsdf = rbind(readsumsdf, data.frame(nreads = sort(sample_sums(H35_thr_rare), TRUE), sorted = 1:nsamples(H35_thr_rare), type = "Samples"))
title = "Total number of reads"
#plot results
p_1 = ggplot(readsumsdf, aes(x = sorted, y = nreads)) + geom_bar(stat = "identity")
p_1 + ggtitle(title) + scale_y_log10() + facet_wrap(~type, 1, scales = "free")
# Calculate alpha diversity [Richness, Shannon] for both sexes using untrimmed
alpha_summary_H35_thr_rare<- estimate_richness(H35_thr_rare, measures = c("Observed", "Shannon"))
# Combine results with sample_data. This is useful if we wish to plot later against other variable or information.
alpha_meta_H35_thr_rare <- data.frame(alpha_summary_H35_thr_rare, sample_data(H35_thr_rare))
#Plot observed richness and Shannon diversity values for both sexes
p_2 = plot_richness(H35_thr_rare, x = "RUNCENTER", measures=c("Observed", "Shannon"))
#Add a boxplot using the geom function of ggplot
p_2 + geom_boxplot()
summary(alpha_summary_H35_thr_rare)
##Kruskal-Wallis test for correlation between observed species and RUNCENTER
kruskal.test(Observed ~ RUNCENTER, data = alpha_meta_H35_thr_rare)
kruskal.test(Shannon ~ RUNCENTER, data = alpha_meta_H35_thr_rare)
#Ordinate data using Non-metric multidimensional scaling (NMDS) on Bray-Curtis dissimilarity (distances)
NMDS_thr.ord <- ordinate(H35_thr_rare, "NMDS", "bray")
#By calling the newly created file we can get the stress value of the plot
NMDS_thr.ord
#stressplot
library(vegan)
stressplot(NMDS_thr.ord)
NMDS_thr_plot = plot_ordination(H35_thr_rare, NMDS_thr.ord, type = "samples", color = "RUNCENTER") + scale_colour_manual(values=c("black", "blue", "green", "red", "yellow", "magenta", "purple", "orange"))
NMDS_thr_plot
#Select variable to test for grouping
RUNCENTER_group = get_variable(H35_thr_rare, "RUNCENTER")
#Perform ANOSIM
RUNCENTER_ano = anosim(phyloseq::distance(H35_thr_rare, "bray"), RUNCENTER_group)
#Is the observed grouping statistically significant?
RUNCENTER_ano$signif
#How strong is the grouping?
RUNCENTER_ano$statistic
#Create a data frame using your sample_data
df = as(sample_data(H35_thr_rare), "data.frame")
#Calculate your Bray distance matrix
d = distance(H35_thr_rare, "bray")
#Perform your ADONIS test
bodysiteadonis = adonis(d ~ RUNCENTER, df)
#Check results
bodysiteadonis
