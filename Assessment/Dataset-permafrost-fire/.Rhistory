testMD.mis$ph <- with(testMD.mis, impute(as.numeric(ph), fun="random"))
testMD.mis$averagesoilrelativehumidity <- with(testMD.mis, impute(as.numeric(averagesoilrelativehumidity), fun="random"))
testMD.mis$averagesoiltemperature <- with(testMD.mis, impute(as.numeric(averagesoiltemperature), fun="random"))
testMD.mis$electrical_conductivity <- with(testMD.mis, impute(as.numeric(electrical_conductivity), fun="random"))
testMD.mis$soil_organic_carbon <- with(testMD.mis, impute(as.numeric(soil_organic_carbon), fun="random"))
