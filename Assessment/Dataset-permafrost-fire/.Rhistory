summary(testMD.mis)
testMD.mis$averagesoilrelativehumidity <-as.numeric(testMD.mis$averagesoilrelativehumidity)
testMD.mis$averagesoiltemperature <-as.numeric(testMD.mis$averagesoiltemperature)
testMD.mis$electrical_conductivity <-as.numeric(testMD.mis$electrical_conductivity)
testMD.mis$soil_organic_carbon <-as.numeric(testMD.mis$soil_organic_carbon)
