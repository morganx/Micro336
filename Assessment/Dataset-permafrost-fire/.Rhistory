```{r}
alpha_summary_GST<- estimate_richness(Tas_rare_phyloseq, measures = c("Observed", "Shannon"))
summary(alpha_summary_GST)
# Combine results with sample_data. This is useful if we wish to plot later against other variable or information.
alpha_meta_GST <- data.frame(alpha_summary_GST, sample_data(Tas_rare_phyloseq))
p = plot_richness(Tas_rare_phyloseq, x = "depth", measures=c("Observed", "Shannon"), color = "Treatment")
#Add a boxplot using the geom function of ggplot
p + geom_boxplot()
kruskal.test(Observed ~ depth, data = alpha_meta_GST)
kruskal.test(Shannon ~ depth, data = alpha_meta_GST)
