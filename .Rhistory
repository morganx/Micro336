library(dada2)
library(phyloseq)
library(Rqc)
# First, change our path to the directory containing the fastq files after unzipping so R can find these files
path <- "~/micro336/data"
qa<-rqc(path=path, pattern=".fq.gz")
library(knitr)
setwd("~/Micro336/")
knit(input="~/Micro336/Lab2.RMD", encoding='UTF-8')
render(input="~/Micro336/Lab2.RMD", encoding='UTF-8', "pdf_document")
knit_with_parameters('~/Micro336/Lab2.RMD')
knit_with_parameters('~/Micro336/Lab2.md')
